# Server Port
PORT=3000

# WebApp URL (For Telegram Mini App testing, use ngrok or local/deployed URL, e.g. https://your-domain.com or https://xxxx.ngrok-free.app)
WEBAPP_URL=http://localhost:3000

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# BSC Hot Wallet Private Key for Auto Payouts (BEP20 USDT)
HOT_WALLET_PRIVATE_KEY=your_bsc_hot_wallet_private_key_here
